#!/bin/bash
# Fake Maestro CLI for tests/adt.test.sh: answers
#   --device <serial> test --format junit --output <xml> --test-output-dir <dir> <flows...>
# with a JUnit report shaped like Maestro's own. Each flow's comments decide
# its outcome, as in tests/shims/auto-mobile. Calls are recorded in
# $FAKE_ADT_STATE/maestro.calls.
state="${FAKE_ADT_STATE:?}"
device="" output="" files=()
while [ $# -gt 0 ]; do
  case "$1" in
    --device) device="$2"; shift 2 ;;
    --output) output="$2"; shift 2 ;;
    --format|--test-output-dir) shift 2 ;;
    test) shift ;;
    *) files+=("$1"); shift ;;
  esac
done
echo "test device=$device flows=${#files[@]}" >> "$state/maestro.calls"
failures=0
{
  echo '<?xml version="1.0" encoding="UTF-8"?>'
  echo "<testsuites>"
  echo "  <testsuite name=\"Test Suite\" device=\"$device\" tests=\"${#files[@]}\">"
  for f in "${files[@]}"; do
    name="$(basename "$f" .yaml)"
    outcome=pass
    if grep -q '# fake: fail' "$f"; then outcome=fail; fi
    if grep -q '# fake: flaky' "$f" && [ ! -f "$state/flaky.$name" ]; then
      touch "$state/flaky.$name"; outcome=fail
    fi
    if [ "$outcome" = pass ]; then
      echo "    <testcase id=\"$name\" name=\"$name\" classname=\"$name\" file=\"$f\" time=\"1.6\" status=\"SUCCESS\"/>"
    else
      failures=$((failures + 1))
      echo "    <testcase id=\"$name\" name=\"$name\" classname=\"$name\" file=\"$f\" time=\"3.2\" status=\"ERROR\">"
      echo "      <failure>Assertion is false: id: order_confirmation_title is visible</failure>"
      echo "    </testcase>"
    fi
  done
  echo "  </testsuite>"
  echo "</testsuites>"
} > "$output"
[ "$failures" -eq 0 ]
